{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "UniCore",
    "Audience": "UniCore.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ClockSkewSeconds": 30
  },
  "PasswordReset": {
    "AppName": "UniCore",
    "OtpLifetimeMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxRequestsPerHour": 5,
    "ResetTokenMinutes": 10
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "Username": "",
    "Password": "",
    "FromName": "UniCore",
    "FromAddress": "no-reply@unicore.local",
    "TimeoutSeconds": 15
  }
}
